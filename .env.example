# ============================================================================
# Intelbase - environment variables (example)
# Copy this file to `.env.local` and fill in real values.
# Do NOT commit `.env.local`. The app COMPILES without these set, but auth and
# the related features only FUNCTION once real values are provided.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (auth + database)  [added by the auth/database foundation]
# ---------------------------------------------------------------------------
# Project URL + anon (public) key are safe to expose to the browser.
# Find them in: Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key is SECRET (server-only, bypasses RLS). Never expose to the
# browser. Used by server-side admin tasks / Stripe webhooks that write billing.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------------------------------------------------------------------------
# Stripe (billing)  [owned by the Stripe/onboarding agent]
# ---------------------------------------------------------------------------
# Secret API key (server-only). Find it in: Stripe Dashboard -> Developers ->
# API keys. The app COMPILES and the public site runs with this UNSET; billing
# endpoints return a clear 503 and subscription gating is skipped until it is set.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret for /api/stripe/webhook. From: Stripe Dashboard ->
# Developers -> Webhooks -> (your endpoint) -> Signing secret. If unset, the
# webhook acknowledges events without processing (no crash).
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs, one per plan + interval (Products -> your plan -> Pricing).
# starter = $99/mo, growth = $299/mo, scale = $799/mo.
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
STRIPE_PRICE_SCALE_MONTHLY=price_...
STRIPE_PRICE_SCALE_ANNUAL=price_...

# Public base URL of this app, used to build Stripe success/cancel/return URLs.
# Falls back to the incoming request origin when unset. e.g. https://intelbase.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Agent / model
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-...

# ---------------------------------------------------------------------------
# Leads + booking
# ---------------------------------------------------------------------------
BOOKING_URL=https://cal.com/your-handle
LEAD_STORE=file
LEAD_STORE_FILE=./.leads.json

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
